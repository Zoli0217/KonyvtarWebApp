@page
@model KonyvtarWebApp.Pages.KonyvPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Konyv[0].Cim)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Konyv[0].KiadasEve)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Konyv[0].Szerzo)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Konyv) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Cim)
            </td>
            <td>
                @Html.DisplayFor(model => item.KiadasEve)
            </td>
            <td>
                @Html.DisplayFor(model => item.Szerzo.Nev)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
